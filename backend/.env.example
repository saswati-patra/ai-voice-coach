APP_ENV=local
APP_NAME=AI Voice Coach
DEV_USER_ID=dev-user
GOOGLE_CLOUD_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
